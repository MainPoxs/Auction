@using Online_Auction.Models
@using System.Globalization
@model Online_Auction.Models.Lot

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/styles/indexstyle.css">
    <link rel="stylesheet" type="text/css" href="styles/lotstyle.css">
    <link rel="stylesheet" href="/styles/editlotstyle.css">
    <title>Редактирование лота</title>
</head>
<body>
    <div class="container">
        <a href="/usaccount" class="back-link">&#8592; Назад в кабинет</a>

        <h2>&#9998; Редактирование лота</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)  
        {
            <div class="alert alert-success">@TempData["Success"]</div> 
        }

        <form method="post" enctype="multipart/form-data"
              action="/lot/edit/@Model.Id" class="edit-form">
            @* защита от CSRF-атак *@
            @Html.AntiForgeryToken()           
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-group">
                <label for="Title">Название лота *</label>
                <input type="text" id="Title" name="Title" value="@Model.Title" required minlength="3">               
            </div>

            <div class="form-group">
                <label for="DescriptionLot">Описание *</label>
                <textarea id="DescriptionLot" name="DescriptionLot"
                    rows="4" required minlength="10">@Model.DescriptionLot
                </textarea>               
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="StartPrice">Начальная цена, ₽ *</label>
                    <input type="number" id="StartPrice" name="StartPrice"
                           value="@Model.StartPrice"
                           min="0.01" step="0.01" required>
                </div>

                <div class="form-group">
                    <label for="CategoryId">Категория</label>
                    <select id="CategoryId" name="CategoryId">
                        <option value="">Выберите категорию</option>
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">
                                    @cat.NameC
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="EndDate">Дата окончания *</label>
                <input type="datetime-local" id="EndDate" name="EndDate"
                       value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" required>
            </div>

            <div class="form-group">
                <label>Текущее изображение</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Текущее фото" class="preview-img">
                }
            </div>

            <div class="form-group">
                <label for="imageFile">Загрузить новое изображение</label>
                <input type="file" id="imageFile" name="imageFile" accept="image/*">
                <small class="form-hint">Оставьте пустым, чтобы сохранить текущее</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">&#128190; Сохранить изменения</button>
                <a href="/usaccount" class="btn-secondary">Отмена</a>
            </div>
        </form>
        <footer class="footer">
            <div class="footer-content">
                <nav class="footer-nav">
                    <a href="/allresults">Все лоты</a>
                    <a href="/about">О проекте</a>
                    <a href="/rules">Правила</a>
                </nav>

                <div class="social-icons">
                    <span><img src="/images/github.png" alt="логотип" /></span>
                    <span><img src="/images/vk.png" alt="логотип" /></span>
                    <span><img src="/images/MAX-32x32.png" alt="логотип" /></span>
                </div>
            </div>

            <div class="footer-divider"></div>
            <div class="footer-bottom">
                <p>&copy; 2026 Интернет-аукцион. Все права защищены.</p>
            </div>
        </footer>
    </div>
    
</body>
</html>