@using Online_Auction.Models
@model List<Purchase>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/styles/indexstyle.css">
    <link rel="stylesheet" type="text/css" href="styles/accountstyle.css">
    <link rel="stylesheet" type="text/css" href="/styles/purchases.css">
    <title>Мои покупки - Интернет-аукцион</title>
</head>
<body>
    <div class="container">
       
        <div class="header">
            <div class="menu-user">
                <a href="/" class="back-link">&#127968; На главную</a>
                <a href="/mypurchases" class="back-link">&#128188;Мои покупки</a>
                <div class="top-section">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="/usaccount" class="user-link">&#128100;</a>
                    }
                    <div class="user-info">
                        <a href="/logout">Выйти</a>
                    </div>
                </div>
            </div>
        </div>

        <main class="main">

            @* Если покупок нет *@
            @if (Model == null || Model.Count == 0)
            {
                <div class="empty-message">
                    <p>У вас пока нет выигранных лотов</p>
                    <a href="/" class="btn-primary">Посмотреть активные аукционы</a>
                </div>
            }
            else
            {
                @* Список покупок *@
                <table class="purchases-table">
                    <thead>
                        <tr>
                            <th>Лот</th>                            
                            <th>Продавец</th>
                            <th>Цена</th>
                            <th>Дата покупки</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody class="table-tr">
                        @foreach (var purchase in Model)
                        {
                           <tr>                           
                               <td>
                                   <div class="lot-cell">
                                       <img src="@purchase.Lot.ImageUrl" alt="@purchase.Lot.Title"
                                       class="lot-thumb">                                        
                                       <div>
                                           <strong>@purchase.Lot?.Title</strong><br>
                                           <small class="text-muted">Лот #@purchase.LotId</small>
                                       </div>
                                   </div>
                               </td>

                               @* Продавец *@
                               <td>
                                   @purchase.Seller?.FirstName @purchase.Seller?.LastName
                               </td>

                               @* Цена *@
                               <td class="price-cell">
                                   <strong>@purchase.FinalPrice &#8381;</strong>
                               </td>

                               @* Дата *@
                               <td>
                                   @(purchase.PurchaseDate?.ToString("dd.MM.yyyy"))
                               </td>

                               @* Статус *@
                               <td>
                                   <span class="status-badge status-@purchase.StatusP?.ToLower()">
                                       @GetStatusText(purchase.StatusP)
                                   </span>
                                   @if (purchase.StatusP == "NoPaid")
                                   {
                                       <div class="status-badge status-@purchase.StatusP?.ToLower()">
                                           <small>&#9200; Оплатите до:
                                               @(purchase.PurchaseDate?.AddDays(1).ToString("dd.MM.yyyy"))</small>
                                       </div>
                                   }
                               </td>

                               @* Кнопки *@
                                <td class="actions-cell">
                                    <div class="btn-group">
                                        <a href="/trading/@purchase.LotId"
                                        class="btn-small btn-info" title="Посмотреть лот">
                                            &#128269; Детали
                                        </a>

                                        @if (purchase.StatusP == "NoPaid")
                                        {
                                            <a href="/pay/@purchase.LotId"
                                               class="btn-small btn-info" title="Оплатить">
                                                &#128269; Оплатить
                                            </a>                                           
                                        }

                                        @if (purchase.StatusP == "Paid")
                                        {
                                            <a href="#"
                                               class="btn-small btn-outline" title="Связаться с продавцом">
                                                &#128172; Связаться
                                            </a>
                                        }
                                       
                                    </div>
                                </td>
                           </tr>
                        }
                    </tbody>
                </table>
            }
        </main>

        <footer class="footer">
            <div class="footer-content">
                <nav class="footer-nav">
                    <a href="/allresults">Все лоты</a>
                    <a href="/about">О проекте</a>
                    <a href="/rules">Правила</a>
                </nav>

                <div class="social-icons">
                    <span><img src="/images/github.png" alt="логотип" /></span>
                    <span><img src="/images/vk.png" alt="логотип" /></span>
                    <span><img src="/images/MAX-32x32.png" alt="логотип" /></span>
                </div>
            </div>

            <div class="footer-divider"></div>
            <div class="footer-bottom">
                <p>&copy; 2026 Интернет-аукцион. Все права защищены.</p>
            </div>
        </footer>
    </div>   

    @* Метод для статуса *@
    @functions {
        string GetStatusText(string? status)
        {
            return status switch
            {
                "Won" => "Выигран",
                "NoPaid" => "Ожидает оплаты",
                "Paid" => "Оплачен",
                "Shipped" => "Отправлен",
                "Completed" => "Завершён",
                "Cancelled" => " Отменён",
                _ => "Неизвестно"
            };
        }
    }
</body>
</html>